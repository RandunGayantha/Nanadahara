# These are SERVER-ONLY env vars for the /api Vercel functions — set them in
# Vercel project settings (or `vercel env pull` for local `vercel dev`), never
# in the root .env (which only holds VITE_ vars exposed to the browser).

# From Firebase Console -> Project settings -> Service accounts ->
# Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# The TextBee SMS gateway (https://textbee.dev, runs on an Android phone) is
# NOT configured here — its API key and device ID are set by the admin at
# Admin -> Settings in the app itself (stored in Firestore `settings/textbee`,
# read via the Admin SDK), so they can be changed at runtime without a redeploy.
